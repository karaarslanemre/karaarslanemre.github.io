---
// The footer drawing: the site's four sections as connected nodes.
interface Props {
  active?: 'about' | 'writing' | 'books' | 'projects' | null;
}
const { active = null } = Astro.props;

const main = [
  { key: 'about', href: '/', label: 'About Me', x: 170, y: 150, r: 44, arc: 110, side: 'left' },
  { key: 'writing', href: '/writing/', label: 'Writing', x: 430, y: 92, r: 52, arc: 75, side: 'right' },
  { key: 'books', href: '/books/', label: 'Books', x: 655, y: 214, r: 40, arc: 140, side: 'right' },
  { key: 'projects', href: '/projects/', label: 'Projects', x: 868, y: 96, r: 42, arc: 200, side: 'left' },
];
const small = [
  [76, 62], [52, 246], [320, 238], [340, 34], [560, 36], [520, 270], [790, 270], [960, 220], [962, 34], [262, 72],
];
const lines = [
  [170, 150, 430, 92], [430, 92, 655, 214], [655, 214, 868, 96],
  [170, 150, 76, 62], [170, 150, 52, 246], [170, 150, 320, 238], [170, 150, 262, 72],
  [430, 92, 340, 34], [430, 92, 560, 36], [320, 238, 520, 270],
  [655, 214, 520, 270], [655, 214, 790, 270], [868, 96, 962, 34], [868, 96, 960, 220], [790, 270, 960, 220],
];

// A thick arc from 12 o'clock, clockwise by `deg` degrees.
const arcPath = (x: number, y: number, r: number, deg: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  const ex = x + r * Math.cos(a);
  const ey = y + r * Math.sin(a);
  return `M${x} ${y - r}A${r} ${r} 0 ${deg > 180 ? 1 : 0} 1 ${ex.toFixed(2)} ${ey.toFixed(2)}`;
};
---
<svg class="sitemap" viewBox="0 0 1000 300" role="img" aria-label="Site map">
  {lines.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
  {small.map(([x, y]) => (
    <g>
      <circle class="sm" cx={x} cy={y} r="12" />
      <circle class="sm-core" cx={x} cy={y} r="3" />
    </g>
  ))}
  {main.map((n) => (
    <a href={n.href} aria-label={n.label}>
      <circle class:list={['ring', active === n.key && 'ring--on']} cx={n.x} cy={n.y} r={n.r} />
      {active !== n.key && <path class="arc" d={arcPath(n.x, n.y, n.r, n.arc)} />}
      <circle class="core" cx={n.x} cy={n.y} r="6" />
      <text
        class="t-main"
        x={n.side === 'left' ? n.x - n.r - 14 : n.x + n.r + 14}
        y={n.y + 6}
        text-anchor={n.side === 'left' ? 'end' : 'start'}
      >{n.label}</text>
    </a>
  ))}
</svg>
