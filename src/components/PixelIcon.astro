  link: { w: 8, h: 8, d: 'M3 0h5v1h-5zM5 1h3v1h-3zM4 2h2v1h-2zM7 2h1v1h-1zM3 3h2v1h-2zM7 3h1v1h-1zM0 4h1v1h-1zM2 4h2v1h-2zM0 5h1v1h-1zM2 5h1v1h-1zM0 6h1v1h-1zM0 7h6v1h-6z' },
} as const;

interface Props {
  name: keyof typeof icons;
  class?: string;
}

const { name, class: className } = Astro.props;
const icon = icons[name];
---
<svg class:list={['px', className]} viewBox={`0 0 ${icon.w} ${icon.h}`} aria-hidden="true">
  <path d={icon.d} />
</svg>
