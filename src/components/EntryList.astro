---
import PixelIcon from './PixelIcon.astro';
import {
  entryHref,
  isExternal,
  readingMinutes,
  type WritingEntry,
} from '../lib/writing';

interface Props {
  entries: WritingEntry[];
  /** Total number of published entries, used for the #001-style numbers. */
  total?: number;
  headingLevel?: 'h2' | 'h3';
  /** Adds a "next entry loading" tile at the end. */
  showNext?: boolean;
}

const { entries, total = entries.length, headingLevel = 'h2', showNext = false } = Astro.props;
const Heading = headingLevel;
const COLORS = 7;

// Dates like 09.22.26
const shortDate = (d: Date) =>
  [d.getUTCMonth() + 1, d.getUTCDate(), d.getUTCFullYear() % 100]
    .map((n) => String(n).padStart(2, '0'))
    .join('.');
---
<ul class="tiles">
  {entries.map((entry, i) => {
    // Entries arrive newest first; the oldest is #001, so numbers and colors
    // stay the same as new pieces are added.
    const number = total - i;
    const external = isExternal(entry);
    return (
      <li class:list={['tile', `tile-c${(number - 1) % COLORS}`]}>
        <a
          class="tile-link"
          href={entryHref(entry)}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener' : undefined}
        >
          <div class="tile-top">
            <span>#{String(number).padStart(3, '0')}</span>
            <time datetime={entry.data.date.toISOString().slice(0, 10)}>{shortDate(entry.data.date)}</time>
          </div>
          <div class="tile-body">
            <p class="tile-kicker">
              {external
                ? `${entry.data.publication || 'Elsewhere'} ↗`
                : `Post · ${readingMinutes(entry.body)} min read`}
            </p>
            <Heading class="tile-title">{entry.data.title}</Heading>
            {entry.data.summary && <p class="tile-desc">{entry.data.summary}</p>}
          </div>
        </a>
      </li>
    );
  })}
  {showNext && (
    <li class="tile" aria-hidden="true">
      <div class="tile-next">
        <PixelIcon name="chart" />
        <span>Next entry loading<span class="cursor">_</span></span>
      </div>
    </li>
  )}
</ul>
