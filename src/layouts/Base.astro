---
import '../styles/global.css';
import site from '../data/site.json';
import PixelIcon from '../components/PixelIcon.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'about' | 'writing' | null;
}

const { title, description = site.intro, active = null } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Accept links typed with or without "https://".
const toUrl = (value?: string) => {
  const v = (value ?? '').trim();
  if (!v) return '';
  return /^https?:\/\//i.test(v) ? v : `https://${v}`;
};

const links = [
  { label: 'LinkedIn', href: toUrl(site.linkedin) },
  { label: 'X', href: toUrl(site.x) },
].filter((link) => link.href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fonts. To change a font, edit this link and the names in src/styles/global.css. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;500;700&family=VT323&display=swap"
    />

    <script is:inline>
      try {
        var saved = localStorage.getItem('ek-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.setAttribute('data-theme', saved);
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <div class="side-top">
          <a class="brand" href="/">
            <PixelIcon name="chart" />
            <span class="brand-name">{site.name}</span>
          </a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme">
            <PixelIcon name="sun" class="icon-sun" />
            <PixelIcon name="moon" class="icon-moon" />
          </button>
        </div>

        <hr class="rule" />

        {site.intro && <p class="side-intro">{site.intro}</p>}

        <nav class="side-nav" aria-label="Main">
          <a href="/" aria-current={active === 'about' ? 'page' : undefined}>
            <PixelIcon name="person" />
            About me
          </a>
          <a href="/writing/" aria-current={active === 'writing' ? 'page' : undefined}>
            <PixelIcon name="page" />
            Writing
          </a>
        </nav>

        <div class="side-bottom">
          <div class="contact-links">
            {site.email && (
              <a class="contact-link" href={`mailto:${site.email}`}>
                <PixelIcon name="mail" />
                {site.email}
              </a>
            )}
            {links.map((link) => (
              <a class="contact-link" href={link.href} target="_blank" rel="noopener">
                <PixelIcon name="link" />
                {link.label}
              </a>
            ))}
          </div>
          {site.disclaimer && <p>{site.disclaimer}</p>}
        </div>
      </aside>

      <main class="main">
        <div class="content">
          <slot />

          <footer class="page-foot">
            <div class="contact-links">
              {site.email && (
                <a class="contact-link" href={`mailto:${site.email}`}>
                  <PixelIcon name="mail" />
                  {site.email}
                </a>
              )}
              {links.map((link) => (
                <a class="contact-link" href={link.href} target="_blank" rel="noopener">
                  <PixelIcon name="link" />
                  {link.label}
                </a>
              ))}
            </div>
            {site.disclaimer && <p>{site.disclaimer}</p>}
          </footer>
        </div>
      </main>
    </div>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var toggle = document.getElementById('theme-toggle');
        function syncLabel() {
          var dark = root.getAttribute('data-theme') === 'dark';
          toggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
        }
        toggle.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('ek-theme', next); } catch (e) {}
          syncLabel();
        });
        syncLabel();
      })();
    </script>
  </body>
</html>
