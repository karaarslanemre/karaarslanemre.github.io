---
import '../styles/global.css';
import site from '../data/site.json';
import Band from '../components/Band.astro';
import SiteMap from '../components/SiteMap.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'about' | 'writing' | 'books' | null;
}

const { title, description = site.writingIntro, active = null } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Accept links typed with or without "https://".
const toUrl = (value?: string) => {
  const v = (value ?? '').trim();
  if (!v) return '';
  return /^https?:\/\//i.test(v) ? v : `https://${v}`;
};
const links = [
  { label: 'LinkedIn', href: toUrl((site as any).linkedin) },
  { label: 'X', href: toUrl((site as any).x) },
].filter((link) => link.href);

const nav = [
  { key: 'about', href: '/', label: 'About Me' },
  { key: 'writing', href: '/writing/', label: 'Writing' },
  { key: 'books', href: '/books/', label: 'Books' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#EBEBEA" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fonts. To change a font, edit this link and the names in src/styles/global.css. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Hanken+Grotesk:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">{site.name}</a>
      <nav class="nav" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>

    <main class="page">
      <slot />
    </main>

    <Band class="footer">
      <Fragment slot="note">
        {site.disclaimer && <p class="small">{site.disclaimer}</p>}
        <p class="small">© {new Date().getFullYear()} {site.name}</p>
      </Fragment>
      <SiteMap active={active} />
      <div class="contact">
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
        {links.map((link) => <a href={link.href} target="_blank" rel="noopener">{link.label} ↗</a>)}
      </div>
    </Band>

    <script>
      import '../scripts/figures.ts';
    </script>
  </body>
</html>
