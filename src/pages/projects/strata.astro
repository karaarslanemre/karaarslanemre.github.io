---
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import Figure from '../../components/Figure.astro';
import MarginArt from '../../components/MarginArt.astro';
import config from '../../data/strata.json';
import '../../styles/strata.css';

// The free server's address (the Cloudflare Worker). Empty until it's set up,
// in which case visitors can still try the example or use their own key.
// (ZR_SERVER overrides it for local testing.) A typo here shouldn't break the
// site, so anything that isn't a web address is treated as "not set".
function serverUrl(value: string): string {
  const v = value.trim();
  if (!v) return '';
  try {
    const url = new URL(/^https?:\/\//i.test(v) ? v : `https://${v}`);
    return url.origin;
  } catch {
    return '';
  }
}
// Two builds of this page: the one on this site, and a copy hosted on
// claude.ai ("Open in Claude"), where Claude writes the levels on each
// visitor's own Claude plan. scripts/build-strata-claude.mjs makes the copy
// by building with STRATA_TARGET=claude.
const onClaude = process.env.STRATA_TARGET === 'claude';
const server = onClaude ? '' : serverUrl(process.env.ZR_SERVER ?? config.server ?? '');
const serverOrigin = server;

// The claude.ai copy's address, from src/data/strata.json. Shown only on
// this site, and only once it's a claude.ai link.
function claudeLink(value?: string): string {
  try {
    const url = new URL((value ?? '').trim());
    return url.protocol === 'https:' && /(^|\.)claude\.ai$/.test(url.hostname) ? url.href : '';
  } catch {
    return '';
  }
}
const claudeUrl = onClaude ? '' : claudeLink((config as { claude?: string }).claude);

// Lock the page down: it may only load its own files and Google Fonts, and
// only talk to the free server and the three AI companies. This is what keeps
// a visitor's API key from being sent anywhere else.
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data:",
  `connect-src 'self' ${serverOrigin} https://api.anthropic.com https://generativelanguage.googleapis.com https://api.openai.com`.replace(/\s+/g, ' '),
  "worker-src 'self' blob:",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
const withCsp = !process.env.ZR_PREVIEW && !onClaude;

const description = 'Upload a PDF or paste any text, then zoom in to have it explained from first principles, or zoom out to see the summary.';
const levels = [
  { v: -2, label: 'Gist', desc: 'the whole document in a few sentences' },
  { v: -1, label: 'Summary', desc: 'a short paragraph per part' },
  { v: 0, label: 'Original', desc: 'the text as written' },
  { v: 1, label: 'Explained', desc: 'in plain language' },
  { v: 2, label: 'First principles', desc: 'built up from the basics' },
];
const sign = (v: number) => (v > 0 ? `+${v}` : v < 0 ? `−${-v}` : '0');
---
<Base title="Strata" description={description} active="projects">
  {withCsp && <meta slot="head" http-equiv="Content-Security-Policy" content={csp} />}
  <meta slot="head" name="referrer" content="strict-origin-when-cross-origin" />

  <Band hero center>
    <Fragment slot="note">
      <p><a href="/projects/">← All projects</a></p>
      <p class="muted">Project 01<br />November 2026</p>
    </Fragment>
    <Fragment slot="margin"><MarginArt kind="layers" /></Fragment>
    <div class="hero-wrap">
      <h1 class="hero">Strata</h1>
      <Figure kind="ribbon" />
    </div>
    <div class="lead">
      <p>Upload a PDF or paste any text, then zoom. Zoom in and each passage is explained in more depth, all the way down to first principles. Zoom out and it’s summarized, all the way up to a single gist.</p>
    </div>
  </Band>

  <div id="zr" class="zr" data-server={server} data-model={config.modelLabel} data-target={onClaude ? 'claude' : 'site'} data-claude={claudeUrl}>
    <Band id="zr-input">
      <Fragment slot="note">
        <p class="zr-legend-title">Five levels</p>
        <ol class="zr-legend">
          {levels.map((l) => (
            <li><span class="zr-legend-n">{sign(l.v)}</span><span><strong>{l.label}</strong><br /><span class="muted">{l.desc}</span></span></li>
          ))}
        </ol>
      </Fragment>

      <div class="band-head"><h2 class="h2">Start with a document.</h2></div>

      <p class="zr-continue" data-continue-wrap hidden>
        Pick up where you left off: <button type="button" class="zr-link" data-continue>“<span data-continue-title></span>” →</button>
      </p>

      <div class="zr-start">
        <label class="zr-tile zr-drop" id="zr-drop" for="zr-file">
          <span class="zr-tile-top"><span>(A)</span><span>PDF</span></span>
          <span class="zr-tile-body">
            <span class="zr-tile-title">Upload a PDF</span>
            <span class="zr-tile-desc">Drop a file here or click to choose one. It’s read on your own device.</span>
          </span>
          <input type="file" id="zr-file" class="visually-hidden" accept="application/pdf,.pdf" />
        </label>

        <form class="zr-tile zr-paste" id="zr-paste">
          <span class="zr-tile-top"><span>(B)</span><span data-count></span></span>
          <label class="zr-tile-title" for="zr-text">Paste text</label>
          <textarea id="zr-text" rows="7" placeholder="An article, a report, a chapter…" spellcheck="false"></textarea>
          <button type="submit" class="zr-button">Read it</button>
        </form>
      </div>

      <p class="zr-example-line">
        Or try it on an example: <button type="button" class="zr-link" data-example>my essay “Actuators” →</button>
      </p>
      {claudeUrl && (
        <p class="zr-example-line zr-claude-line">
          Have a Claude account? <a class="zr-link" href={claudeUrl} target="_blank" rel="noopener">Open in Claude ↗</a> to run Strata on your own Claude plan, with no key.
        </p>
      )}

      <p id="zr-status" class="zr-status" role="status" aria-live="polite" hidden></p>

      {onClaude && (
        <p class="zr-status" data-kind="error" data-claude-off hidden>
          Claude can’t write explanations here. Open this page in Claude, signed in to your account. The example works anywhere.
        </p>
      )}

      <div class="zr-fine">
        {onClaude ? (
          <p>
            Explanations are written by Claude and count toward your own Claude plan. The first time you zoom, Claude asks
            whether this page may use it. Only the passages you zoom into are sent to Claude, and nothing is kept. Strata also
            lives on <a class="zr-link" href="/projects/strata/">my website ↗</a>.
          </p>
        ) : (
          <p>
            Explanations are written by an AI model, {config.modelLabel}, running on Cloudflare’s free daily allowance, which
            every visitor shares. If it runs out, you can carry on with your own API key
            (<button type="button" class="zr-link" data-input-settings>AI settings</button>){claudeUrl && <> or <a class="zr-link" href={claudeUrl} target="_blank" rel="noopener">open Strata in Claude</a></>}. Only the passages you zoom into are
            sent to the AI, and this site doesn’t keep your document.
          </p>
        )}
      </div>
    </Band>

    <section class="zr-reader" id="zr-reader" aria-label="Reader" hidden>
      <div class="zr-toolbar">
        <div class="zr-tb-note">
          <p class="zr-doc-title" data-doc-title></p>
          <p class="zr-tb-actions">
            <button type="button" class="zr-link" data-new>New document</button>
            {!onClaude && <button type="button" class="zr-link" data-settings>AI settings</button>}
          </p>
        </div>
        <div class="zr-tb-main">
          <div class="zr-zoom" role="group" aria-label="Zoom the whole document">
            <button type="button" class="zr-zbtn" data-zoom="out" aria-label="Zoom out">−</button>
            <ol class="zr-scale">
              {levels.map((l) => (
                <li>
                  <button type="button" data-level={l.v} aria-pressed="false" title={`${l.label}: ${l.desc}`}>
                    <span class="zr-dot"><span class="zr-node"></span></span>
                    <span class="zr-scale-label">{l.label}</span>
                  </button>
                </li>
              ))}
            </ol>
            <button type="button" class="zr-zbtn" data-zoom="in" aria-label="Zoom in">+</button>
          </div>
          <p class="zr-level-now" data-level-now aria-hidden="true"></p>
          <div class="zr-tb-foot">
            <p class="zr-hint" data-hint></p>
            <p class="zr-mode" data-mode></p>
          </div>
        </div>
      </div>

      <div class="zr-rows" id="zr-rows"></div>

      <div class="zr-row zr-row--end">
        <div class="zr-margin"><div class="zr-where"><span class="zr-tag">End</span></div></div>
        <div class="zr-body">
          <p class="zr-end-text">
            <button type="button" class="zr-link" data-zoom-top>Back to the top</button>
          </p>
        </div>
      </div>
    </section>

    <div class="zr-notice" id="zr-notice" role="alert" hidden>
      <p data-notice-text></p>
      <p class="zr-notice-actions">
        {claudeUrl && <a class="zr-button" href={claudeUrl} target="_blank" rel="noopener">Open in Claude ↗</a>}
        <button type="button" class={claudeUrl ? 'zr-link' : 'zr-button'} data-notice-key>Use my own API key</button>
        <button type="button" class="zr-link" data-notice-close>Not now</button>
      </p>
    </div>
  </div>

  {!onClaude && <dialog id="zr-key-dialog" class="zr-dialog" aria-labelledby="zr-key-title">
    <form method="dialog">
      <h2 id="zr-key-title" class="zr-dialog-title">Use your own API key</h2>
      <p class="zr-dialog-reason" data-reason hidden></p>
      {claudeUrl && (
        <p class="zr-dialog-alt">
          Have a Claude account? <a href={claudeUrl} target="_blank" rel="noopener">Open in Claude ↗</a> instead and Strata runs on
          your own Claude plan, with no key.
        </p>
      )}

      <fieldset class="zr-providers">
        <legend>AI company</legend>
        <label><input type="radio" name="provider" value="anthropic" checked /> Anthropic (Claude)</label>
        <label><input type="radio" name="provider" value="gemini" /> Google (Gemini)</label>
        <label><input type="radio" name="provider" value="openai" /> OpenAI</label>
      </fieldset>

      <label class="zr-field">
        <span>API key</span>
        <input name="key" type="password" autocomplete="off" spellcheck="false" />
      </label>
      <p class="zr-get-key"><a data-get-key href="https://platform.claude.com/settings/keys" target="_blank" rel="noopener noreferrer">Get an Anthropic key ↗</a></p>

      <details class="zr-model">
        <summary>Model (optional)</summary>
        <label class="zr-field">
          <span class="visually-hidden">Model name</span>
          <input name="model" type="text" autocomplete="off" spellcheck="false" />
        </label>
        <p class="muted">Leave empty to use the one shown.</p>
      </details>

      <label class="zr-check"><input type="checkbox" name="remember" /> Remember on this device</label>

      <div class="zr-safety">
        <p><strong>To be safe,</strong> make a separate key just for this, with a low spending limit, and delete it when you’re done. Google offers free Gemini keys, though on its free tier Google may use what you send to improve its products. <a href="https://github.com/karaarslanemre/karaarslanemre.github.io/tree/main/src/strata" target="_blank" rel="noopener">Read the code ↗</a></p>
      </div>

      <p class="zr-error" data-error hidden></p>

      <div class="zr-dialog-actions">
        <button type="button" class="zr-link" data-forget hidden>Forget my key</button>
        <span class="zr-dialog-spacer"></span>
        <button value="cancel" formnovalidate class="zr-link">Cancel</button>
        <button value="save" class="zr-button">Save and continue</button>
      </div>
    </form>
  </dialog>}

  <script>
    import '../../strata/app.ts';
  </script>
</Base>
