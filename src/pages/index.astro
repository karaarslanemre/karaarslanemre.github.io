---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { Content as AboutText, frontmatter } from '../data/about.md';
import { getPublishedWriting } from '../lib/writing';

const latest = (await getPublishedWriting()).slice(0, 3);
const heading = frontmatter.title || 'About me';
---
<Base active="about">
  <section class="view">
    <h1 class="display">{heading}</h1>

    <div class="lead">
      <AboutText />
    </div>

    {latest.length > 0 && (
      <section class="section" aria-labelledby="latest-heading">
        <div class="section-head">
          <h2 class="h2" id="latest-heading">Latest writing</h2>
          <a class="button-outline" href="/writing/">View all</a>
        </div>
        <EntryList entries={latest} headingLevel="h3" />
      </section>
    )}
  </section>
</Base>
