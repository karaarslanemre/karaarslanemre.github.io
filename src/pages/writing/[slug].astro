---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import {
  formatFullDate,
  getPublishedWriting,
  isExternal,
  readingMinutes,
  type WritingEntry,
} from '../../lib/writing';

// One page per post written on this site. Entries with an external link
// (like the Contrary Research report) link out instead and get no page here.
export async function getStaticPaths() {
  const posts = (await getPublishedWriting()).filter((entry) => !isExternal(entry));
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: WritingEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary ?? undefined} active="writing">
  <Band hero center>
    <Fragment slot="note">
      <p><a href="/writing/">← All writing</a></p>
      <p class="muted">
        <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatFullDate(entry.data.date)}</time><br />
        {readingMinutes(entry.body)} min read
      </p>
    </Fragment>
    <h1 class="hero hero--post">{entry.data.title}</h1>
  </Band>

  <Band lines="b">
    <article class="prose">
      <Content />
    </article>
  </Band>
</Base>
